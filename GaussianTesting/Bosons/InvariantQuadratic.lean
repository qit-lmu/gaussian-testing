module

public import Mathlib.Basic.Complex.Basic
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Adjoin.Basic

/-! # The quadratic invariants of identical rotations and reflections of two copies -/

@[expose] public section

namespace GaussianTesting

open MvPolynomial

/-- The `(i,j)` Gram entry of two real position vectors. -/
noncomputable def copyGramPolynomial (m : ℕ) (i j : Fin m) : MvPolynomial (Fin 2 × Fin m) ℂ :=
  X (0, i) * X (0, j) + X (1, i) * X (1, j)

/-- The polynomial algebra generated by the Gram entries. -/
noncomputable def copyGramAlgebra (m : ℕ) : Subalgebra ℂ (MvPolynomial (Fin 2 × Fin m) ℂ) :=
  Algebra.adjoin ℂ (Set.range (fun ij : Fin m × Fin m => copyGramPolynomial m ij.1 ij.2))

theorem copyGramPolynomial_mem (m : ℕ) (i j : Fin m) :
    copyGramPolynomial m i j ∈ copyGramAlgebra m :=
  Algebra.subset_adjoin ⟨(i, j), rfl⟩

end GaussianTesting

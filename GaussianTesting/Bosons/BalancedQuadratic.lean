module

public import GaussianTesting.Bosons.InvariantQuadratic
public import Mathlib.Algebra.MvPolynomial.PDeriv

import Mathlib.Tactic

/-!
# Symmetric quadratic lowering on balanced polynomial sectors

In complex copy coordinates `u,v`, the quadratic creation operators are
`u_i v_j + u_j v_i`. Their Fischer adjoints are the symmetric mixed partial
derivatives. The elementary joint-kernel calculation below is the algebraic
step needed to generate the swap-even balanced sectors from the vacuum.
-/

@[expose] public section

namespace GaussianTesting

open MvPolynomial

noncomputable section

/-- The quadratic invariants in complex copy coordinates. -/
def symmetricMixedPolynomial (m : ℕ) (i j : Fin m) : MvPolynomial (Fin 2 × Fin m) ℂ :=
  X (0, i) * X (1, j) + X (0, j) * X (1, i)

/-- The algebra generated by the symmetric mixed quadratic invariants. -/
def symmetricMixedAlgebra (m : ℕ) : Subalgebra ℂ (MvPolynomial (Fin 2 × Fin m) ℂ) :=
  Algebra.adjoin ℂ (Set.range (fun ij : Fin m × Fin m => symmetricMixedPolynomial m ij.1 ij.2))

/-- Interchange the two complex copy-coordinate families. -/
def copyModeSwap (m : ℕ) :
    MvPolynomial (Fin 2 × Fin m) ℂ →ₐ[ℂ] MvPolynomial (Fin 2 × Fin m) ℂ :=
  rename (fun ai => (ai.1.rev, ai.2))

private theorem copyModeSwap_index_injective (m : ℕ) :
    Function.Injective (fun ai : Fin 2 × Fin m => (ai.1.rev, ai.2)) := by
  intro a b h
  have ha := congrArg (fun ai : Fin 2 × Fin m => ai.1) h
  have hb := congrArg (fun ai : Fin 2 × Fin m => ai.2) h
  exact Prod.ext (Fin.rev_injective ha) hb

theorem copyModeSwap_involutive (m : ℕ) (p : MvPolynomial (Fin 2 × Fin m) ℂ) :
    copyModeSwap m (copyModeSwap m p) = p := by
  simp only [copyModeSwap, rename_rename, Function.comp_def, Fin.rev_rev, Prod.eta]
  exact rename_id_apply p

@[simp] theorem copyModeSwap_X (m : ℕ) (a : Fin 2) (i : Fin m) :
    copyModeSwap m (X (a, i)) = X (a.rev, i) := by
  exact rename_X _ _

theorem copyModeSwap_pderiv (m : ℕ) (a : Fin 2) (i : Fin m)
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) :
    copyModeSwap m (pderiv (a, i) p) = pderiv (a.rev, i) (copyModeSwap m p) := by
  exact (pderiv_rename (copyModeSwap_index_injective m) (a, i) p).symm

/-- The Euler operator in one of the two complex copy-coordinate families. -/
def copyModeEuler (m : ℕ) (a : Fin 2) (p : MvPolynomial (Fin 2 × Fin m) ℂ) :
    MvPolynomial (Fin 2 × Fin m) ℂ :=
  ∑ i, X (a, i) * pderiv (a, i) p

theorem copyModeSwap_euler (m : ℕ) (a : Fin 2)
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) :
    copyModeSwap m (copyModeEuler m a p) = copyModeEuler m a.rev (copyModeSwap m p) := by
  simp only [copyModeEuler, map_sum, map_mul, copyModeSwap_pderiv, copyModeSwap_X]

/-- Symmetric mixed quadratic lowering. -/
def symmetricMixedLowering (m : ℕ) (i j : Fin m)
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) : MvPolynomial (Fin 2 × Fin m) ℂ :=
  pderiv (0, i) (pderiv (1, j) p) + pderiv (0, j) (pderiv (1, i) p)

theorem copyModeSwap_lowering (m : ℕ) (i j : Fin m)
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) :
    copyModeSwap m (symmetricMixedLowering m i j p) =
      symmetricMixedLowering m i j (copyModeSwap m p) := by
  simp only [symmetricMixedLowering, map_add, copyModeSwap_pderiv]
  norm_num
  rw [pderiv_comm (1, i) (0, j), pderiv_comm (1, j) (0, i), add_comm]

/-- The three differentiated skew-symmetry relations force every partial
derivative involving two `u` coordinates and one `v` coordinate to vanish. -/
theorem mixed_third_derivative_eq_zero {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) (i j k : Fin m) :
    pderiv (0, i) (pderiv (0, k) (pderiv (1, j) p)) = 0 := by
  have h₁ := congrArg (pderiv (0, k)) (hp i j)
  have h₂ := congrArg (pderiv (0, i)) (hp k j)
  have h₃ := congrArg (pderiv (0, j)) (hp i k)
  simp only [symmetricMixedLowering, map_add, map_zero] at h₁ h₂ h₃
  rw [pderiv_comm (0, k) (0, i)] at h₁
  rw [pderiv_comm (0, j) (0, i), pderiv_comm (0, j) (0, k)] at h₃
  have h : (2 : ℂ) • pderiv (0, i) (pderiv (0, k) (pderiv (1, j) p)) = 0 := by
    rw [two_smul]
    linear_combination h₁ + h₂ - h₃
  exact (smul_eq_zero.mp h).resolve_left (by norm_num)

/-- A nonzero `v` degree and the quadratic lowering equations already force
all pure second derivatives in the `u` variables to vanish. -/
theorem first_copy_second_derivative_eq_zero {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) (k : ℕ) (hk : k ≠ 0)
    (hev : copyModeEuler m 1 p = (k : ℂ) • p)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) (i l : Fin m) :
    pderiv (0, i) (pderiv (0, l) p) = 0 := by
  have h := congrArg (fun q => pderiv (0, i) (pderiv (0, l) q)) hev
  simp only [copyModeEuler, map_sum, pderiv_mul, map_add, Derivation.map_smul,
    pderiv_X, Pi.single_apply, Prod.mk.injEq] at h
  norm_num at h
  simp only [mixed_third_derivative_eq_zero p hp, mul_zero, Finset.sum_const_zero] at h
  exact (smul_eq_zero.mp h.symm).resolve_left (by exact_mod_cast hk)

theorem second_copy_second_derivative_eq_zero {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) (k : ℕ) (hk : k ≠ 0)
    (heu : copyModeEuler m 0 p = (k : ℂ) • p)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) (i l : Fin m) :
    pderiv (1, i) (pderiv (1, l) p) = 0 := by
  have he := congrArg (copyModeSwap m) heu
  rw [copyModeSwap_euler, map_smul] at he
  have hp' (i j : Fin m) : symmetricMixedLowering m i j (copyModeSwap m p) = 0 := by
    rw [← copyModeSwap_lowering, hp, map_zero]
  have h := first_copy_second_derivative_eq_zero (copyModeSwap m p) k hk (by simpa using he)
    hp' i l
  have hh := congrArg (copyModeSwap m) h
  simpa only [copyModeSwap_pderiv, copyModeSwap_involutive, map_zero,
    show (0 : Fin 2).rev = 1 from rfl] using hh

private theorem polynomial_eq_constant_of_pderiv_eq_zero {σ : Type*}
    (p : MvPolynomial σ ℂ) (hp : ∀ i, pderiv i p = 0) :
    p = C (constantCoeff p) := by
  classical
  ext d
  by_cases hd : d = 0
  · simp [hd, constantCoeff_eq]
  obtain ⟨i, hi⟩ : ∃ i, d i ≠ 0 := by
    by_contra! hz
    exact hd (Finsupp.ext hz)
  have h := congrArg (fun q : MvPolynomial σ ℂ => q.coeff (d - Finsupp.single i 1)) (hp i)
  rw [coeff_pderiv, Finsupp.sub_add_single_one_cancel hi, AddMonoidAlgebra.coeff_zero] at h
  simp only [Finsupp.zero_apply] at h
  have hn : (((d - Finsupp.single i 1 : σ →₀ ℕ) i : ℕ) : ℂ) + 1 ≠ 0 := by
    exact_mod_cast (Nat.succ_ne_zero ((d - Finsupp.single i (1 : ℕ)) i))
  have hc : p.coeff d = 0 := (mul_eq_zero.mp h).resolve_right hn
  simp [hc, coeff_C, Ne.symm hd]

/-- In positive balanced sectors, every mixed second derivative in the
joint kernel is a constant polynomial. -/
theorem mixed_second_derivative_is_constant {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) (k : ℕ) (hk : k ≠ 0)
    (heu : copyModeEuler m 0 p = (k : ℂ) • p)
    (_hev : copyModeEuler m 1 p = (k : ℂ) • p)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) (i j : Fin m) :
    pderiv (0, i) (pderiv (1, j) p) =
      C (constantCoeff (pderiv (0, i) (pderiv (1, j) p))) := by
  apply polynomial_eq_constant_of_pderiv_eq_zero
  rintro ⟨a, l⟩
  fin_cases a
  · exact mixed_third_derivative_eq_zero p hp l j i
  · change pderiv (1, l) (pderiv (0, i) (pderiv (1, j) p)) = 0
    rw [pderiv_comm (1, l) (0, i),
      second_copy_second_derivative_eq_zero p k hk heu hp l j, map_zero]

/-- In degree one the joint kernel consists of alternating tensors, so its
intersection with the swap-fixed sector is zero. -/
theorem symmetricMixedLowering_jointKernel_eq_zero_degree_one {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ)
    (heu : copyModeEuler m 0 p = p) (hev : copyModeEuler m 1 p = p)
    (hswap : copyModeSwap m p = p)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) : p = 0 := by
  have hc := mixed_second_derivative_is_constant p 1 (by norm_num)
    (by simpa using heu) (by simpa using hev) hp
  have hexp : p = ∑ i, ∑ j,
      (X (0, i) * X (1, j)) * pderiv (0, i) (pderiv (1, j) p) := by
    calc
      p = copyModeEuler m 0 (copyModeEuler m 1 p) := by rw [hev, heu]
      _ = _ := by
        simp only [copyModeEuler, map_sum, Finset.mul_sum, pderiv_mul, pderiv_X,
          Pi.single_apply, Prod.mk.injEq]
        norm_num
        congr 1
        funext i
        congr 1
        funext j
        ring
  have hneg : copyModeSwap m p = -p := by
    have hc' (i j : Fin m) : copyModeSwap m (pderiv (0, i) (pderiv (1, j) p)) =
        pderiv (0, i) (pderiv (1, j) p) := by
      rw [hc i j]
      simp [copyModeSwap]
    calc
      copyModeSwap m p = ∑ i, ∑ j,
          X (1, i) * X (0, j) * pderiv (0, i) (pderiv (1, j) p) := by
        have h := congrArg (copyModeSwap m) hexp
        simpa only [map_sum, map_mul, hc', copyModeSwap_X,
          show (0 : Fin 2).rev = 1 from rfl, show (1 : Fin 2).rev = 0 from rfl] using h
      _ = -(∑ i, ∑ j, X (0, i) * X (1, j) * pderiv (0, i) (pderiv (1, j) p)) := by
        rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro i _
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro j _
        have h := hp i j
        dsimp [symmetricMixedLowering] at h
        rw [eq_neg_of_add_eq_zero_right h]
        ring
      _ = -p := congrArg Neg.neg hexp.symm
  have htwo : (2 : ℂ) • p = 0 := by
    rw [two_smul]
    calc
      p + p = copyModeSwap m p + p := congrArg (fun q => q + p) hswap.symm
      _ = 0 := by rw [hneg, neg_add_cancel]
  exact (smul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- In every balanced sector with degree at least two, the symmetric mixed
lowering operators have trivial joint kernel even before imposing swap
symmetry. The degree-one joint kernel is the alternating tensor sector. -/
theorem symmetricMixedLowering_jointKernel_eq_zero_of_two_le {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) (k : ℕ) (hk : 2 ≤ k)
    (heu : copyModeEuler m 0 p = (k : ℂ) • p)
    (hev : copyModeEuler m 1 p = (k : ℂ) • p)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) : p = 0 := by
  have hsecond := first_copy_second_derivative_eq_zero p k (by omega) hev hp
  have hfirst (i : Fin m) : pderiv (0, i) p = 0 := by
    have h := congrArg (pderiv (0, i)) heu
    simp only [copyModeEuler, map_sum, pderiv_mul, pderiv_X, Pi.single_apply,
      Prod.mk.injEq, true_and, Derivation.map_smul, hsecond, mul_zero, add_zero] at h
    simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true] at h
    have hz : ((k : ℂ) - 1) • pderiv (0, i) p = 0 := by
      rw [sub_smul, one_smul, ← h, sub_self]
    apply (smul_eq_zero.mp hz).resolve_left
    exact_mod_cast (show (k : ℤ) - 1 ≠ 0 by omega)
  have hzero : (k : ℂ) • p = 0 := by
    rw [← heu]
    simp [copyModeEuler, hfirst]
  exact (smul_eq_zero.mp hzero).resolve_left (by exact_mod_cast (show k ≠ 0 by omega))

/-- The symmetric mixed quadratic lowering operators have no nonzero joint
kernel in any positive balanced sector fixed by interchange of the copies. -/
theorem symmetricMixedLowering_jointKernel_eq_zero {m : ℕ}
    (p : MvPolynomial (Fin 2 × Fin m) ℂ) (k : ℕ) (hk : 0 < k)
    (heu : copyModeEuler m 0 p = (k : ℂ) • p)
    (hev : copyModeEuler m 1 p = (k : ℂ) • p)
    (hswap : copyModeSwap m p = p)
    (hp : ∀ i j, symmetricMixedLowering m i j p = 0) : p = 0 := by
  by_cases hk1 : k = 1
  · subst k
    exact symmetricMixedLowering_jointKernel_eq_zero_degree_one p
      (by simpa using heu) (by simpa using hev) hswap hp
  · exact symmetricMixedLowering_jointKernel_eq_zero_of_two_le p k (by omega) heu hev hp

end

end GaussianTesting

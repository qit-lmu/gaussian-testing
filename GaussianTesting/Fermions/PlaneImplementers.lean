public import GaussianTesting.Fermions.GaussianAction
public import GaussianTesting.Fermions.PlaneRotations
public import GaussianTesting.Fermions.PlaneUnitaries

@[expose] public section

/-!
# Lifting Majorana coordinate-plane rotations

The explicit unitary `α I + β c_a c_b` implements the real plane rotation
with coefficients `p = α² − β²` and `q = 2αβ`. Every real plane rotation has
such a half-angle lift. These elementary lifts and irrelevant scalar phases
are the ingredients required for arbitrary Gaussian implementers.
-/

namespace GaussianTesting

noncomputable section

variable {m : ℕ}

private lemma plane_column_fst {a b : Fin m × Bool} (hab : a ≠ b)
    (p q : ℝ) (f : (Fin m × Bool) → HF m) :
    ∑ k, ((planeRotationMatrix a b p q) k a : ℂ) • f k =
      (p : ℂ) • f a - (q : ℂ) • f b := by
  have he (k : Fin m × Bool) : planeRotationMatrix a b p q k a =
      (if k = a then p else 0) + (if k = b then -q else 0) := by
    by_cases ha : k = a <;> by_cases hb : k = b <;>
      simp_all [planeRotationMatrix, eq_comm]
  simp_rw [he, Complex.ofReal_add, add_smul]
  simp [Finset.sum_add_distrib, sub_eq_add_neg]

private lemma plane_column_snd {a b : Fin m × Bool} (hab : a ≠ b)
    (p q : ℝ) (f : (Fin m × Bool) → HF m) :
    ∑ k, ((planeRotationMatrix a b p q) k b : ℂ) • f k =
      (q : ℂ) • f a + (p : ℂ) • f b := by
  have he (k : Fin m × Bool) : planeRotationMatrix a b p q k b =
      (if k = a then q else 0) + (if k = b then p else 0) := by
    by_cases ha : k = a <;> by_cases hb : k = b <;>
      simp_all [planeRotationMatrix, eq_comm]
  simp_rw [he, Complex.ofReal_add, add_smul]
  simp [Finset.sum_add_distrib]

private lemma plane_column_other {a b e : Fin m × Bool}
    (hea : e ≠ a) (heb : e ≠ b)
    (p q : ℝ) (f : (Fin m × Bool) → HF m) :
    ∑ k, ((planeRotationMatrix a b p q) k e : ℂ) • f k = f e := by
  have he (k : Fin m × Bool) : planeRotationMatrix a b p q k e =
      if k = e then 1 else 0 := by
    by_cases ha : k = a <;> by_cases hb : k = b <;>
      simp_all [planeRotationMatrix, eq_comm]
  simp_rw [he]
  simp

/-- The explicit Majorana-plane unitary implements the corresponding
double-angle rotation, with the manuscript's column convention. -/
theorem givensEquiv_implements (α β : ℝ) (hαβ : α ^ 2 + β ^ 2 = 1)
    (a b : Fin m × Bool) (hab : a ≠ b) :
    ImplementsMajoranaRotation
      ⟨planeRotationMatrix a b (α ^ 2 - β ^ 2) (2 * α * β),
        planeRotationMatrix_mem hab (by nlinarith [hαβ])⟩
      (givensEquiv α β hαβ a b hab) := by
  apply implementsMajoranaRotation_of_columns
  intro e ψ
  change givensU α β a b (maj e ψ) =
    ∑ k, ((planeRotationMatrix a b (α ^ 2 - β ^ 2) (2 * α * β)) k e : ℂ) •
      maj k (givensU α β a b ψ)
  have hi : givensU α (-β) a b (givensU α β a b ψ) = ψ :=
    congrArg (fun T : HF m →ₗ[ℂ] HF m => T ψ) (givensU_inv_comp hαβ hab)
  by_cases hea : e = a
  · subst e
    rw [plane_column_fst hab]
    have h := congrArg (fun T : HF m →ₗ[ℂ] HF m => T (givensU α β a b ψ))
      (givensU_conj_fst hαβ hab)
    simpa only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.smul_apply, hi] using h
  · by_cases heb : e = b
    · subst e
      rw [plane_column_snd hab]
      have h := congrArg (fun T : HF m →ₗ[ℂ] HF m => T (givensU α β a b ψ))
        (givensU_conj_snd hαβ hab)
      simpa only [LinearMap.comp_apply, LinearMap.add_apply, LinearMap.smul_apply, hi] using h
    · rw [plane_column_other hea heb]
      have h := congrArg (fun T : HF m →ₗ[ℂ] HF m => T (givensU α β a b ψ))
        (givensU_conj_other hαβ hab hea heb)
      simpa only [LinearMap.comp_apply, hi] using h

private lemma exists_halfangle {p q : ℝ} (hpq : p ^ 2 + q ^ 2 = 1) :
    ∃ α β : ℝ, α ^ 2 + β ^ 2 = 1 ∧ α ^ 2 - β ^ 2 = p ∧ 2 * α * β = q := by
  by_cases hp : p = -1
  · have hq : q = 0 := by nlinarith [sq_nonneg q]
    exact ⟨0, 1, by norm_num, by norm_num [hp], by simp [hq]⟩
  · have hp' : -1 < p := by
      have hle : -1 ≤ p := by nlinarith [sq_nonneg q]
      exact lt_of_le_of_ne hle (Ne.symm hp)
    let α := Real.sqrt ((1 + p) / 2)
    have ha : α ^ 2 = (1 + p) / 2 := Real.sq_sqrt (by linarith)
    have ha' : 0 < α := Real.sqrt_pos.mpr (by linarith)
    let β := q / (2 * α)
    have hq : 2 * α * β = q := by
      dsimp [β]
      field_simp
    have hb : β ^ 2 = (1 - p) / 2 := by
      have hh : (2 * α * β) ^ 2 = q ^ 2 := congrArg (fun t : ℝ => t ^ 2) hq
      have hh' : 4 * α ^ 2 * β ^ 2 = q ^ 2 := by nlinarith [hh]
      rw [ha] at hh'
      nlinarith
    exact ⟨α, β, by linarith, by linarith, hq⟩

/-- Every real coordinate-plane rotation has an implementer in the group
generated by the explicit Majorana-plane unitaries. -/
theorem exists_planeUnitary_implements_planeRotation
    (a b : Fin m × Bool) (hab : a ≠ b) (p q : ℝ) (hpq : p ^ 2 + q ^ 2 = 1) :
    ∃ U : HF m ≃ₗᵢ[ℂ] HF m, U ∈ planeUnitaryGroup m ∧
      ImplementsMajoranaRotation
        ⟨planeRotationMatrix a b p q, planeRotationMatrix_mem hab hpq⟩ U := by
  obtain ⟨α, β, hαβ, hp, hq⟩ := exists_halfangle hpq
  refine ⟨givensEquiv α β hαβ a b hab,
    givensEquiv_mem_planeUnitaryGroup α β hαβ a b hab, ?_⟩
  simpa only [hp, hq] using givensEquiv_implements α β hαβ a b hab

/-- A scalar phase acts trivially on the Majorana coordinates. -/
theorem fermionPhaseEquiv_implements (z : ℂ) (hz : ‖z‖ = 1) :
    ImplementsMajoranaRotation (1 : FermionRotation m) (fermionPhaseEquiv z hz) := by
  intro v ψ
  simp only [fermionPhaseEquiv_apply, OneMemClass.coe_one, Matrix.one_mulVec, map_smul]

end
end GaussianTesting

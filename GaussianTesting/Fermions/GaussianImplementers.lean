public import GaussianTesting.Fermions.PlaneImplementers
public import GaussianTesting.Fermions.MajoranaCommutant
public import GaussianTesting.Fermions.SpecialOrthogonalGeneration

@[expose] public section

/-!
# Gaussian implementers of special orthogonal Majorana rotations

The manuscript specifies these unitaries by their action on the Majoranas.
The construction uses coordinate-plane rotations; uniqueness up to phase
identifies all possible implementers with the same generated unitary group.
-/

namespace GaussianTesting

noncomputable section

variable {m : ℕ}

/-- Every elementary plane rotation or phase is a Gaussian implementer. -/
theorem planeUnitaryGroup_le_gaussianUnitaryGroup :
    planeUnitaryGroup m ≤ gaussianUnitaryGroup m := by
  apply (Subgroup.closure_le (gaussianUnitaryGroup m)).2
  rintro U (⟨z, hz, rfl⟩ | ⟨α, β, hαβ, a, b, hab, rfl⟩)
  · exact ⟨1, fermionPhaseEquiv_implements z hz⟩
  · exact ⟨_, givensEquiv_implements α β hαβ a b hab⟩

/-- The defining Majorana action determines its implementer up to global phase. -/
theorem ImplementsMajoranaRotation.unique_phase {R : FermionRotation m}
    {U V : HF m ≃ₗᵢ[ℂ] HF m}
    (hU : ImplementsMajoranaRotation R U) (hV : ImplementsMajoranaRotation R V) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ ∀ ψ : HF m, U ψ = z • V ψ := by
  apply exists_phase_of_same_majorana_conjugation U V
  intro a ψ
  rw [hU.majorana, hV.majorana]

/-- Every special orthogonal Majorana rotation has a unitary implementer,
constructed from plane rotations. -/
theorem exists_gaussianImplementer (R : FermionRotation m) :
    ∃ U : HF m ≃ₗᵢ[ℂ] HF m, U ∈ planeUnitaryGroup m ∧
      ImplementsMajoranaRotation R U := by
  apply specialOrthogonal_induction
    (P := fun R => ∃ U : HF m ≃ₗᵢ[ℂ] HF m, U ∈ planeUnitaryGroup m ∧
      ImplementsMajoranaRotation R U) ?_ ?_ ?_ ?_ R
  · exact ⟨1, (planeUnitaryGroup m).one_mem, ImplementsMajoranaRotation.one⟩
  · rintro A B ⟨U, hU, hA⟩ ⟨V, hV, hB⟩
    exact ⟨U * V, (planeUnitaryGroup m).mul_mem hU hV, hA.mul hB⟩
  · rintro A ⟨U, hU, hA⟩
    exact ⟨U⁻¹, (planeUnitaryGroup m).inv_mem hU, hA.inv⟩
  · intro a b p q hab hpq
    exact exists_planeUnitary_implements_planeRotation a b hab p q hpq

/-- The independent Majorana-action definition gives exactly the group
generated by the explicit plane rotations and scalar phases. -/
theorem gaussianUnitaryGroup_eq_planeUnitaryGroup (m : ℕ) :
    gaussianUnitaryGroup m = planeUnitaryGroup m := by
  apply le_antisymm ?_ planeUnitaryGroup_le_gaussianUnitaryGroup
  rintro U ⟨R, hR⟩
  obtain ⟨V, hV, hRV⟩ := exists_gaussianImplementer R
  obtain ⟨z, hz, hUV⟩ := hR.unique_phase hRV
  have hU : U = fermionPhaseEquiv z hz * V := by
    apply LinearIsometryEquiv.ext
    intro ψ
    exact hUV ψ
  rw [hU]
  exact (planeUnitaryGroup m).mul_mem (fermionPhaseEquiv_mem_planeUnitaryGroup z hz) hV

/-- A choice of Gaussian implementer for each rotation. Its scalar phase is
irrelevant to the state orbits. No multiplicative choice of phases is assumed. -/
def gaussianImplementer (R : FermionRotation m) : HF m ≃ₗᵢ[ℂ] HF m :=
  (exists_gaussianImplementer R).choose

theorem gaussianImplementer_implements (R : FermionRotation m) :
    ImplementsMajoranaRotation R (gaussianImplementer R) :=
  (exists_gaussianImplementer R).choose_spec.2

/-- Eq. (5.1): the chosen unitary conjugates Majoranas by the columns of `R`. -/
theorem gaussianImplementer_majorana (R : FermionRotation m)
    (a : Fin m × Bool) (ψ : HF m) :
    gaussianImplementer R (maj a ((gaussianImplementer R).symm ψ)) =
      ∑ b, ((R : Matrix (Fin m × Bool) (Fin m × Bool) ℝ) b a : ℂ) • maj b ψ :=
  (gaussianImplementer_implements R).majorana a ψ

/-- Every Gaussian implementer preserves the two parity sectors. -/
theorem gaussianUnitary_parity {U : HF m ≃ₗᵢ[ℂ] HF m}
    (hU : U ∈ gaussianUnitaryGroup m) (ψ : HF m) :
    parityOp (U ψ) = U (parityOp ψ) := by
  rw [gaussianUnitaryGroup_eq_planeUnitaryGroup] at hU
  exact planeUnitary_parity hU ψ

end
end GaussianTesting

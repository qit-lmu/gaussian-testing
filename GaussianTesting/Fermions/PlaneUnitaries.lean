public import GaussianTesting.Fermions.Gaussian

@[expose] public section

/-!
# Unitaries generated by Majorana plane rotations

This is fermionic background. It uses only the Jordan--Wigner operators and
explicit plane rotations, independently of the certainty criterion in Lemma 5.1.
-/

namespace GaussianTesting
noncomputable section
variable {m : ℕ}

/-- The unitary implementing a rotation in one Majorana coordinate plane. -/
def givensEquiv (α β : ℝ) (hαβ : α ^ 2 + β ^ 2 = 1)
    (a b : Fin m × Bool) (hab : a ≠ b) : HF m ≃ₗᵢ[ℂ] HF m where
  toLinearMap := givensU α β a b
  invFun := givensU α (-β) a b
  left_inv ψ := congrArg (fun T : HF m →ₗ[ℂ] HF m => T ψ) (givensU_inv_comp hαβ hab)
  right_inv ψ := congrArg (fun T : HF m →ₗ[ℂ] HF m => T ψ) (givensU_comp_inv hαβ hab)
  norm_map' := norm_givensU hαβ hab

@[simp] theorem givensEquiv_apply (α β : ℝ) (hαβ : α ^ 2 + β ^ 2 = 1)
    (a b : Fin m × Bool) (hab : a ≠ b) (ψ : HF m) :
    givensEquiv α β hαβ a b hab ψ = givensU α β a b ψ := rfl

/-- Multiplication by a unit complex scalar. -/
def fermionPhaseEquiv (z : ℂ) (hz : ‖z‖ = 1) : HF m ≃ₗᵢ[ℂ] HF m where
  toLinearEquiv := LinearEquiv.smulOfNeZero ℂ (HF m) z (by intro h; simp [h] at hz)
  norm_map' ψ := by simp [LinearEquiv.smulOfNeZero_apply, norm_smul, hz]

@[simp] theorem fermionPhaseEquiv_apply (z : ℂ) (hz : ‖z‖ = 1) (ψ : HF m) :
    fermionPhaseEquiv z hz ψ = z • ψ := rfl

/-- The elementary generators, including the irrelevant global phase. -/
def planeUnitaryGenerators (m : ℕ) : Set (HF m ≃ₗᵢ[ℂ] HF m) :=
  {U | (∃ z hz, U = fermionPhaseEquiv z hz) ∨
    ∃ α β hαβ a b hab, U = givensEquiv α β hαβ a b hab}

/-- Finite products of Majorana plane rotations and global phases. -/
def planeUnitaryGroup (m : ℕ) : Subgroup (HF m ≃ₗᵢ[ℂ] HF m) :=
  Subgroup.closure (planeUnitaryGenerators m)

theorem fermionPhaseEquiv_mem_planeUnitaryGroup (z : ℂ) (hz : ‖z‖ = 1) :
    fermionPhaseEquiv (m := m) z hz ∈ planeUnitaryGroup m :=
  Subgroup.subset_closure (Or.inl ⟨z, hz, rfl⟩)

theorem givensEquiv_mem_planeUnitaryGroup (α β : ℝ) (hαβ : α ^ 2 + β ^ 2 = 1)
    (a b : Fin m × Bool) (hab : a ≠ b) :
    givensEquiv α β hαβ a b hab ∈ planeUnitaryGroup m :=
  Subgroup.subset_closure (Or.inr ⟨α, β, hαβ, a, b, hab, rfl⟩)

theorem IsGaussian.phase {ψ : HF m} (hψ : IsGaussian ψ) (z : ℂ) (hz : ‖z‖ = 1) :
    IsGaussian (z • ψ) := by
  induction hψ with
  | basis x c hc =>
    simpa only [smul_smul] using IsGaussian.basis x (z * c) (by simp [hz, hc])
  | @givens ψ α β hαβ a b hab hψ ih =>
    simpa only [map_smul] using IsGaussian.givens α β hαβ a b hab ih

private theorem isGaussian_phase_iff (z : ℂ) (hz : ‖z‖ = 1) (ψ : HF m) :
    IsGaussian (fermionPhaseEquiv z hz ψ) ↔ IsGaussian ψ := by
  constructor
  · intro h
    have hi : ‖z⁻¹‖ = 1 := by simp [norm_inv, hz]
    have := h.phase z⁻¹ hi
    simpa [fermionPhaseEquiv_apply, smul_smul,
      show z ≠ 0 by intro h; simp [h] at hz] using this
  · exact fun h => h.phase z hz

theorem planeUnitary_isGaussian_iff {U : HF m ≃ₗᵢ[ℂ] HF m}
    (hU : U ∈ planeUnitaryGroup m) (ψ : HF m) : IsGaussian (U ψ) ↔ IsGaussian ψ := by
  induction hU using Subgroup.closure_induction generalizing ψ with
  | mem U hU =>
    rcases hU with ⟨z, hz, rfl⟩ | ⟨α, β, hαβ, a, b, hab, rfl⟩
    · exact isGaussian_phase_iff z hz ψ
    · exact ⟨IsGaussian.of_givens hαβ hab, IsGaussian.givens α β hαβ a b hab⟩
  | one => rfl
  | mul U V hU hV ihU ihV =>
    exact (ihU (V ψ)).trans (ihV ψ)
  | inv U hU ih =>
    simpa using (ih (U⁻¹ ψ)).symm

/-- The coordinate predicate is exactly the orbit of the occupation basis under
finite products of plane rotations and phases. -/
theorem isGaussian_iff_exists_planeUnitary_basis (ψ : HF m) :
    IsGaussian ψ ↔ ∃ U : HF m ≃ₗᵢ[ℂ] HF m, U ∈ planeUnitaryGroup m ∧
      ∃ x : Qm m, U (EuclideanSpace.single x 1) = ψ := by
  constructor
  · intro h
    induction h with
    | basis x z hz => exact ⟨fermionPhaseEquiv z hz, fermionPhaseEquiv_mem_planeUnitaryGroup z hz, x, rfl⟩
    | @givens ψ α β hαβ a b hab hψ ih =>
      obtain ⟨U, hU, x, rfl⟩ := ih
      exact ⟨givensEquiv α β hαβ a b hab * U,
        (planeUnitaryGroup m).mul_mem (givensEquiv_mem_planeUnitaryGroup α β hαβ a b hab) hU, x, rfl⟩
  · rintro ⟨U, hU, x, rfl⟩
    apply (planeUnitary_isGaussian_iff hU _).mpr
    simpa using IsGaussian.basis x 1 (by simp)

private theorem parity_givens (α β : ℝ) (a b : Fin m × Bool) (ψ : HF m) :
    parityOp (givensU α β a b ψ) = givensU α β a b (parityOp ψ) := by
  have h (c : Fin m × Bool) (v : HF m) : parityOp (maj c v) = -maj c (parityOp v) := by
    have h := congrArg (fun T : HF m →ₗ[ℂ] HF m => T v) (parityOp_anticomm_maj c)
    exact eq_neg_of_add_eq_zero_left h
  simp only [givensU, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.id_apply,
    LinearMap.comp_apply, map_add, map_smul, h, map_neg, neg_neg]

theorem planeUnitary_parity {U : HF m ≃ₗᵢ[ℂ] HF m}
    (hU : U ∈ planeUnitaryGroup m) (ψ : HF m) : parityOp (U ψ) = U (parityOp ψ) := by
  induction hU using Subgroup.closure_induction generalizing ψ with
  | mem U hU =>
    rcases hU with ⟨z, hz, rfl⟩ | ⟨α, β, hαβ, a, b, hab, rfl⟩
    · exact map_smul parityOp z ψ
    · exact parity_givens α β a b ψ
  | one => rfl
  | mul U V hU hV ihU ihV => exact (ihU (V ψ)).trans (congrArg U (ihV ψ))
  | inv U hU ih =>
    apply U.injective
    simpa using (ih (U⁻¹ ψ)).symm

end
end GaussianTesting
